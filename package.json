{
  "name": "money-transfer-api",
  "version": "1.0.0",
  "description": "Money Transfer REST API (NestJS, in-memory, Lambda-ready)",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "ddb:start": "docker run --rm -d --name money-transfer-ddb -p 8000:8000 amazon/dynamodb-local",
    "ddb:stop": "docker stop money-transfer-ddb",
    "ddb:setup": "ACCOUNTS_TABLE_NAME=money-transfer-api-accounts-dev TRANSFERS_TABLE_NAME=money-transfer-api-transfers-dev IDEMPOTENCY_TABLE_NAME=money-transfer-api-idempotency-dev ts-node scripts/setup-local-dynamodb.ts",
    "sls:offline": "pnpm build && IS_OFFLINE=true REPO_DRIVER=dynamodb ACCOUNTS_TABLE_NAME=money-transfer-api-accounts-dev TRANSFERS_TABLE_NAME=money-transfer-api-transfers-dev IDEMPOTENCY_TABLE_NAME=money-transfer-api-idempotency-dev serverless offline",
    "deploy": "pnpm build && serverless deploy",
    "deploy:prod": "pnpm build && serverless deploy --stage prod",
    "remove": "serverless remove"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.478.0",
    "@aws-sdk/lib-dynamodb": "^3.478.0",
    "@codegenie/serverless-express": "^4.16.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "^4.21.2",
    "nestjs-pino": "^4.3.0",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/aws-lambda": "^8.10.147",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "serverless": "^3.40.0",
    "serverless-offline": "^13.9.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
